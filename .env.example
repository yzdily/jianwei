# 鉴微 JianWei AI 安全测试平台 - 环境配置
# 复制此文件为 .env 并填入你的配置

# LLM 配置（支持多模型）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# 平台配置
JIANWEI_HOST=0.0.0.0
JIANWEI_PORT=8888
JIANWEI_DEBUG=true

# 玄鉴引擎配置（继承）
XUANJIAN_DATA_DIR=./data
XUANJIAN_LOG_LEVEL=INFO
